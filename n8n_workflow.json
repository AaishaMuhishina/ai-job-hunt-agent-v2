    {
      "parameters": {
        "jsCode": "const mySkills = [\"ai\", \"automation\", \"n8n\", \"low-code\", \"workflow\", \"agent\", \"gpt\", \"llm\", \"genai\"];\n\nconst items = $input.all();\n\nfunction calculateMatch(job) {\n  let score = 0;\n  const matched = [];\n  const title = (job.job_title || '').toLowerCase();\n  const tags = (job.tags || []).map(t => String(t).toLowerCase());\n  \n  for (const skill of mySkills) {\n    const pattern = new RegExp(`\\\\b${skill}\\\\b`, 'i');\n    if (pattern.test(title)) {\n      score += 2;\n      if (!matched.includes(skill)) matched.push(skill);\n    }\n    for (const tag of tags) {\n      if (pattern.test(tag)) {\n        score += 1;\n        if (!matched.includes(skill)) matched.push(skill);\n      }\n    }\n  }\n  return { score, matched };\n}\n\nconst results = items.map(item => {\n  const job = item.json;\n  const { score, matched } = calculateMatch(job);\n  return {\n    title: job.job_title,\n    company: job.company,\n    location: job.location,\n    score: score,\n    matched: matched,\n    apply_link: job.apply_link\n  };\n}).filter(r => r.score > 0)\n  .sort((a, b) => b.score - a.score);\n\nreturn results.slice(0, 5).map(r => ({ json: r }));"
      },
